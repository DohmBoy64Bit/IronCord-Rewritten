# IronCord v2 Environment Configuration
# Copy this file to .env and fill in your actual values

# Application
NODE_ENV=production
PORT=3000

# Security - REQUIRED in production
# Generate a secure random string for JWT_SECRET (min 32 characters)
# Example: openssl rand -base64 32
JWT_SECRET=your-secure-jwt-secret-here-min-32-chars

# Database - REQUIRED
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://ironcord:your-secure-db-password@db:5432/ironcord

# Database credentials (used by podman-compose.yml)
POSTGRES_USER=ironcord
POSTGRES_PASSWORD=your-secure-db-password
POSTGRES_DB=ironcord

# IRC Server
IRC_HOST=localhost
IRC_PORT=6667

# Client CORS
# In production, set this to your frontend URL (e.g., https://ironcord.example.com)
CLIENT_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Development only
# DB_HOST=db
# DB_PORT=5432
# DB_USER=ironcord
# DB_NAME=ironcord
