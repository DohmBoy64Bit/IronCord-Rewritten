{
  "name": "@ironcord/gateway",
  "version": "2.0.0",
  "type": "module",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@ironcord/shared": "*",
    "@ironcord/engine": "*",
    "@ironcord/db": "*",
    "express": "^5.2.1",
    "socket.io": "^4.8.3",
    "bcryptjs": "^3.0.3",
    "jsonwebtoken": "^9.0.3",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/cors": "^2.8.17",
    "@types/node": "^20.11.0",
    "@types/supertest": "^6.0.3",
    "typescript": "^5.3.3",
    "tsx": "^4.7.0",
    "vitest": "^1.2.0",
    "supertest": "^7.2.2",
    "socket.io-client": "^4.8.3",
    "rimraf": "^5.0.5"
  }
}
